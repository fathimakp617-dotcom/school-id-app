# Copy to .env for local development. Use a long unique password.
SCHOOLID_ADMIN_EMAIL=admin@schoolid.app
SCHOOLID_ADMIN_PASSWORD=
SCHOOLID_STAFF_EMAIL=staff@schoolid.app
SCHOOLID_STAFF_PASSWORD=
SCHOOLID_STAFF_CLASS=SA1
SCHOOLID_PARENT_EMAIL=parent@schoolid.app
SCHOOLID_PARENT_PASSWORD=
SCHOOLID_PARENT_STUDENT_ID=S006

# Production only: use a long random value for the RFID device key.
SCHOOLID_RFID_DEVICE_KEY=
CORS_ORIGINS=https://localhost,capacitor://localhost
DATABASE_URL=

# Optional: use an external mounted persistent directory in hosting.
DATA_DIR=./server-data
